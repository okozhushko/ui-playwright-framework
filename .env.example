# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed.

# Base URL the tests run against.
BASE_URL=https://the-internet.herokuapp.com

# Credentials for the demo login sandbox used by the example tests.
# Swap these for your application's real test-account env vars.
TEST_USER_USERNAME=tomsmith
TEST_USER_PASSWORD=SuperSecretPassword!

# A second, unrelated site under test — see pages/opencart/ and
# tests/opencart/. Kept independent of BASE_URL above.
OPENCART_BASE_URL=https://www.opencart.com

# Set by CI providers automatically; useful locally to emulate CI behavior
# (stricter retries/workers, see playwright.config.ts).
CI=false
