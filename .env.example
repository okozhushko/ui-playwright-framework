# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed.

# Base URL the tests run against.
BASE_URL=https://the-internet.herokuapp.com

# Credentials for the demo login sandbox used by the example tests.
# Swap these for your application's real test-account env vars.
TEST_USER_USERNAME=tomsmith
TEST_USER_PASSWORD=SuperSecretPassword!

# A second, unrelated site under test — see pages/opencart/ and
# tests/opencart/. Kept independent of BASE_URL above.
#
# Which of DEV/STAGE/PROD to run against — see config/env.ts. Defaults to
# "prod" if unset. All three default to the same URL below since
# opencart.com has no separate dev/stage deployment of its own; point
# OPENCART_DEV_BASE_URL / OPENCART_STAGE_BASE_URL / OPENCART_PROD_BASE_URL at
# your own app's real per-environment URLs if you're adapting this project.
# TEST_ENV=dev|stage|prod
# OPENCART_DEV_BASE_URL=https://www.opencart.com
# OPENCART_STAGE_BASE_URL=https://www.opencart.com
# OPENCART_PROD_BASE_URL=https://www.opencart.com
#
# Overrides all of the above, regardless of TEST_ENV — for a one-off local
# run against an arbitrary URL. Commented out by default: if this were set
# unconditionally, it would always win and TEST_ENV switching above would
# silently never take effect.
# OPENCART_BASE_URL=https://www.opencart.com

# Set by CI providers automatically; useful locally to emulate CI behavior
# (stricter retries/workers, see playwright.config.ts).
CI=false
