{
  "name": "ui-playwright-framework",
  "version": "1.0.0",
  "description": "Production-ready Playwright UI test automation framework skeleton (TypeScript, Page Object Model).",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:dev": "TEST_ENV=dev playwright test",
    "test:stage": "TEST_ENV=stage playwright test",
    "test:prod": "TEST_ENV=prod playwright test",
    "report": "playwright show-report reports/html",
    "trace": "playwright show-trace",
    "codegen": "playwright codegen",
    "install:browsers": "playwright install --with-deps",
    "typecheck": "tsc --noEmit",
    "lint": "eslint pages tests fixtures reporters utils config playwright.config.ts eslint.config.js --max-warnings 0",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.48.0",
    "@types/node": "^26.1.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "eslint-plugin-playwright": "^2.10.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.64.0"
  },
  "engines": {
    "node": ">=18"
  }
}
